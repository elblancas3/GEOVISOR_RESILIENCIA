<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GeoVisor ZMM · Riesgo Erosivo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
:root {
  --bg:#0f1012; --surface:#181a1e; --surface2:#22252b; --border:#2e3138;
  --blue:#2979ff; --blue2:#82b1ff;
  --orange:#ff6d00; --orange2:#ffab40;
  --green:#00e676; --green2:#69f0ae;
  --red:#ff1744; --red2:#ff8a80;
  --yellow:#ffd740;
  --purple:#d500f9; --teal:#1de9b6;
  --text:#f0f2f5; --text-dim:#9aa3b0; --text-muted:#4a5260;
  --iep1:#1a9641; --iep2:#a6d96a; --iep3:#ffc107; --iep4:#f46d43; --iep5:#d73027;
  --sidebar:320px;
}
* { margin:0; padding:0; box-sizing:border-box; }
html,body { height:100%; overflow:hidden; }
body { background:var(--bg); color:var(--text); font-family:'Barlow Condensed',sans-serif; font-size:15px; }

/* ── LAYOUT ── */
#app { display:flex; height:100vh; width:100vw; position:relative; }
#map { flex:1; height:100%; z-index:1; }

/* ── SIDEBAR ── */
#sidebar {
  width:var(--sidebar); height:100%;
  background:var(--surface);
  border-right:1px solid var(--border);
  display:flex; flex-direction:column;
  z-index:10; flex-shrink:0;
  overflow:hidden;
}
#sidebar-header {
  background:linear-gradient(135deg,#1a6fe8,#7b2fff);
  padding:20px 20px 16px;
  flex-shrink:0;
}
.sh-label { font-size:9px; font-weight:700; letter-spacing:3px; text-transform:uppercase; opacity:.6; margin-bottom:6px; }
.sh-title { font-size:26px; font-weight:900; text-transform:uppercase; letter-spacing:-1px; line-height:1; }
.sh-sub { font-size:12px; opacity:.7; margin-top:5px; }
.sh-status { margin-top:12px; display:flex; gap:8px; flex-wrap:wrap; }
.badge {
  padding:3px 10px; border-radius:100px; font-size:10px; font-weight:700;
  letter-spacing:1px; text-transform:uppercase;
}
.badge-g { background:rgba(0,230,118,.2); color:var(--green); border:1px solid rgba(0,230,118,.3); }
.badge-o { background:rgba(255,109,0,.2); color:var(--orange2); border:1px solid rgba(255,109,0,.3); }
.badge-b { background:rgba(41,121,255,.2); color:var(--blue2); border:1px solid rgba(41,121,255,.3); }

/* ── TABS ── */
#sidebar-tabs { display:flex; border-bottom:1px solid var(--border); flex-shrink:0; }
.stab {
  flex:1; padding:12px 8px; text-align:center; font-size:10px; font-weight:700;
  letter-spacing:1px; text-transform:uppercase; color:var(--text-muted);
  cursor:pointer; border-bottom:2px solid transparent; transition:all .15s;
}
.stab:hover { color:var(--text-dim); }
.stab.active { color:var(--blue2); border-bottom-color:var(--blue2); background:rgba(41,121,255,.05); }

/* ── SIDEBAR BODY ── */
#sidebar-body { flex:1; overflow-y:auto; scrollbar-width:thin; scrollbar-color:var(--border) transparent; }
.s-panel { display:none; padding:16px; }
.s-panel.active { display:block; }

/* ── SECTION HEADERS ── */
.sec-label { font-size:9px; font-weight:800; letter-spacing:2.5px; text-transform:uppercase; color:var(--orange2); margin-bottom:6px; margin-top:14px; }
.sec-label:first-child { margin-top:0; }

/* ── LAYER TOGGLES ── */
.layer-item {
  display:flex; align-items:center; gap:10px;
  padding:10px 12px; border-radius:8px; margin-bottom:4px;
  background:var(--surface2); border:1px solid var(--border);
  cursor:pointer; transition:all .15s;
}
.layer-item:hover { border-color:var(--blue2); }
.layer-item.active { border-color:var(--blue); background:rgba(41,121,255,.08); }
.layer-dot { width:10px; height:10px; border-radius:50%; flex-shrink:0; }
.layer-name { flex:1; font-size:13px; font-weight:600; }
.layer-count { font-size:10px; color:var(--text-muted); font-family:'JetBrains Mono',monospace; }
.toggle-sw {
  width:32px; height:18px; border-radius:9px; position:relative;
  background:var(--border); transition:background .2s; flex-shrink:0; cursor:pointer;
}
.toggle-sw.on { background:var(--blue); }
.toggle-sw::after {
  content:''; position:absolute; top:2px; left:2px;
  width:14px; height:14px; border-radius:50%; background:#fff;
  transition:transform .2s;
}
.toggle-sw.on::after { transform:translateX(14px); }

/* ── FILTER CONTROLS ── */
.filter-group { margin-bottom:14px; }
.filter-label { font-size:11px; font-weight:700; color:var(--text-dim); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px; display:flex; justify-content:space-between; }
.filter-label span { color:var(--text-muted); font-weight:400; font-family:'JetBrains Mono',monospace; font-size:10px; }

/* IEP CLASS BUTTONS */
.iep-btns { display:flex; gap:4px; flex-wrap:wrap; }
.iep-btn {
  padding:5px 10px; border-radius:6px; font-size:11px; font-weight:700;
  cursor:pointer; border:2px solid transparent; transition:all .15s;
  text-transform:uppercase; letter-spacing:.5px;
}
.iep-btn.active { border-color:currentColor; }

/* SLIDER */
.slider-wrap { padding:4px 0; }
input[type=range] {
  width:100%; height:4px; border-radius:2px;
  background:var(--border); outline:none; cursor:pointer;
  -webkit-appearance:none;
}
input[type=range]::-webkit-slider-thumb {
  -webkit-appearance:none; width:16px; height:16px;
  border-radius:50%; background:var(--blue); cursor:pointer;
}

/* ── STATS CARDS ── */
.stats-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:14px; }
.stat-c {
  background:var(--surface2); border:1px solid var(--border);
  border-radius:8px; padding:12px 10px; text-align:center;
}
.stat-c .sv { font-size:26px; font-weight:900; line-height:1; }
.stat-c .sl { font-size:10px; color:var(--text-muted); margin-top:3px; font-weight:600; text-transform:uppercase; letter-spacing:.5px; }

/* IEP BAR CHART */
.iep-bars { margin:8px 0; }
.iep-bar-row { display:flex; align-items:center; gap:8px; margin-bottom:6px; }
.iep-bar-lbl { width:72px; font-size:11px; color:var(--text-dim); display:flex; align-items:center; gap:5px; }
.iep-dot-sm { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
.iep-bar-track { flex:1; height:14px; background:var(--surface2); border-radius:7px; overflow:hidden; }
.iep-bar-fill { height:100%; border-radius:7px; transition:width .4s ease; }
.iep-bar-val { width:42px; text-align:right; font-size:11px; font-weight:700; font-family:'JetBrains Mono',monospace; color:var(--text-dim); }

/* ── INFO PANEL ── */
#info-panel {
  position:absolute; right:16px; top:16px;
  width:280px; background:var(--surface);
  border:1px solid var(--border); border-radius:12px;
  z-index:500; display:none; overflow:hidden;
  box-shadow:0 8px 32px rgba(0,0,0,.4);
}
.ip-header {
  padding:14px 16px 10px;
  border-bottom:1px solid var(--border);
  display:flex; align-items:center; justify-content:space-between;
}
.ip-title { font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:.5px; }
.ip-close { cursor:pointer; color:var(--text-muted); font-size:18px; line-height:1; padding:2px 4px; }
.ip-close:hover { color:var(--text); }
.ip-body { padding:14px 16px; }
.ip-row { display:flex; justify-content:space-between; align-items:center; padding:6px 0; border-bottom:1px solid var(--border); font-size:13px; }
.ip-row:last-child { border-bottom:none; }
.ip-key { color:var(--text-muted); font-weight:500; }
.ip-val { font-weight:800; font-family:'JetBrains Mono',monospace; font-size:12px; }
.ip-iep-bar { height:6px; border-radius:3px; margin-top:10px; margin-bottom:4px; }
.ip-iep-label { font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:1px; }

/* ── SEARCH BOX ── */
#search-box {
  position:absolute; top:16px; left:calc(var(--sidebar) + 16px);
  z-index:500; display:flex; gap:8px;
}
#search-input {
  background:var(--surface); border:1px solid var(--border);
  color:var(--text); padding:10px 14px; border-radius:8px;
  font-family:'Barlow Condensed',sans-serif; font-size:14px; font-weight:500;
  width:200px; outline:none; transition:border-color .15s;
}
#search-input:focus { border-color:var(--blue); }
#search-input::placeholder { color:var(--text-muted); }
.map-btn {
  background:var(--surface); border:1px solid var(--border);
  color:var(--text); padding:10px 14px; border-radius:8px;
  font-family:'Barlow Condensed',sans-serif; font-size:12px; font-weight:700;
  cursor:pointer; transition:all .15s; text-transform:uppercase; letter-spacing:1px;
  white-space:nowrap;
}
.map-btn:hover { border-color:var(--blue); color:var(--blue2); }

/* ── LOADING ── */
#loading {
  position:absolute; inset:0; background:var(--bg);
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  z-index:9999; transition:opacity .5s;
}
#loading.fade { opacity:0; pointer-events:none; }
.ld-logo { font-size:52px; font-weight:900; text-transform:uppercase; letter-spacing:-2px; margin-bottom:8px; }
.ld-logo span { color:var(--orange); }
.ld-sub { font-size:13px; color:var(--text-muted); margin-bottom:32px; }
.ld-bar { width:240px; height:3px; background:var(--border); border-radius:2px; overflow:hidden; }
.ld-prog { height:100%; background:linear-gradient(90deg,var(--blue),var(--orange)); border-radius:2px; animation:ldprog 2.5s ease-out forwards; }
@keyframes ldprog { 0%{width:0} 60%{width:70%} 90%{width:90%} 100%{width:100%} }
.ld-msg { font-size:11px; color:var(--text-muted); margin-top:10px; font-family:'JetBrains Mono',monospace; }

/* ── LEGEND ── */
#legend {
  position:absolute; bottom:40px; right:16px; z-index:500;
  background:var(--surface); border:1px solid var(--border);
  border-radius:10px; padding:14px 16px;
  box-shadow:0 4px 20px rgba(0,0,0,.3);
  min-width:160px;
}
.leg-title { font-size:10px; font-weight:800; letter-spacing:2px; text-transform:uppercase; color:var(--orange2); margin-bottom:10px; }
.leg-row { display:flex; align-items:center; gap:8px; margin-bottom:6px; font-size:12px; }
.leg-swatch { width:14px; height:14px; border-radius:3px; flex-shrink:0; }
.leg-label { color:var(--text-dim); font-weight:600; flex:1; }
.leg-pct { font-size:10px; color:var(--text-muted); font-family:'JetBrains Mono',monospace; }

/* ── SCALE BAR ── */
.leaflet-control-scale-line { background:var(--surface); border-color:var(--border); color:var(--text); font-family:'JetBrains Mono',monospace; font-size:10px; }

/* ── ATTRIBUTION ── */
.leaflet-control-attribution { background:rgba(15,16,18,.8) !important; color:var(--text-muted) !important; font-size:10px !important; }
.leaflet-control-attribution a { color:var(--blue2) !important; }

/* ── ZOOM CONTROLS ── */
.leaflet-control-zoom { border:1px solid var(--border) !important; border-radius:8px !important; overflow:hidden; }
.leaflet-control-zoom a { background:var(--surface) !important; color:var(--text) !important; border-color:var(--border) !important; }
.leaflet-control-zoom a:hover { background:var(--surface2) !important; }

/* ── SCROLLBAR ── */
::-webkit-scrollbar { width:4px; }
::-webkit-scrollbar-track { background:transparent; }
::-webkit-scrollbar-thumb { background:var(--border); border-radius:2px; }

/* ── TOAST ── */
#toast {
  position:absolute; bottom:80px; left:50%; transform:translateX(-50%);
  background:var(--surface2); border:1px solid var(--border);
  padding:10px 20px; border-radius:8px; font-size:13px; font-weight:600;
  z-index:600; opacity:0; transition:opacity .3s; pointer-events:none;
  white-space:nowrap;
}
#toast.show { opacity:1; }

/* ── MUNICIPALITY SELECTOR ── */
.mun-btn {
  display:inline-block; margin:2px; padding:4px 9px; border-radius:5px;
  font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.5px;
  cursor:pointer; border:1px solid var(--border); color:var(--text-dim);
  transition:all .15s;
}
.mun-btn:hover { border-color:var(--blue); color:var(--blue2); }
.mun-btn.active { background:var(--blue); color:#fff; border-color:var(--blue); }

/* ── ELLIPSIS BADGE ── */
.ellipsis-badge {
  position:absolute; bottom:16px; left:calc(var(--sidebar) + 16px); z-index:500;
  background:var(--surface); border:1px solid var(--border);
  border-radius:6px; padding:6px 12px;
  font-size:10px; font-weight:700; letter-spacing:1px; text-transform:uppercase;
  color:var(--text-muted); display:flex; align-items:center; gap:6px;
}
.ed-dot { width:6px; height:6px; border-radius:50%; background:var(--green); animation:pulse 2s infinite; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }
</style>
</head>
<body>

<!-- LOADING -->
<div id="loading">
  <div class="ld-logo">GEO<span>VISOR</span></div>
  <div class="ld-sub">Sistema ZMM · Análisis de Erosión del Suelo</div>
  <div class="ld-bar"><div class="ld-prog"></div></div>
  <div class="ld-msg" id="ld-msg">Inicializando mapa...</div>
</div>

<div id="app">

  <!-- ══ SIDEBAR ══ -->
  <div id="sidebar">
    <div id="sidebar-header">
      <div class="sh-label">Geomática MX · ZMM</div>
      <div class="sh-title">Riesgo<br>Erosivo</div>
      <div class="sh-sub">Zona Metropolitana de Monterrey · 2025</div>
      <div class="sh-status">
        <span class="badge badge-g">✓ IEP v2.0</span>
        <span class="badge badge-o">59,582 manzanas</span>
        <span class="badge badge-b">5 variables</span>
      </div>
    </div>

    <div id="sidebar-tabs">
      <div class="stab active" onclick="showTab('capas')">Capas</div>
      <div class="stab" onclick="showTab('filtros')">Filtros</div>
      <div class="stab" onclick="showTab('stats')">Stats</div>
      <div class="stab" onclick="showTab('info')">Info</div>
    </div>

    <div id="sidebar-body">

      <!-- ── CAPAS ── -->
      <div class="s-panel active" id="tab-capas">
        <div class="sec-label">Capas base</div>

        <div class="layer-item active" onclick="toggleBase('carto')">
          <div class="layer-dot" style="background:#555"></div>
          <span class="layer-name">CartoDB Dark</span>
          <span class="layer-count">base</span>
          <div class="toggle-sw on" id="sw-carto"></div>
        </div>
        <div class="layer-item" onclick="toggleBase('osm')">
          <div class="layer-dot" style="background:#aaa"></div>
          <span class="layer-name">OpenStreetMap</span>
          <span class="layer-count">base</span>
          <div class="toggle-sw" id="sw-osm"></div>
        </div>
        <div class="layer-item" onclick="toggleBase('esri')">
          <div class="layer-dot" style="background:#556B2F"></div>
          <span class="layer-name">ESRI Satélite</span>
          <span class="layer-count">base</span>
          <div class="toggle-sw" id="sw-esri"></div>
        </div>

        <div class="sec-label" style="margin-top:18px;">Capas de análisis</div>

        <div class="layer-item active" id="li-iep" onclick="toggleLayer('iep')">
          <div class="layer-dot" style="background:linear-gradient(135deg,#1a9641,#d73027)"></div>
          <span class="layer-name">IEP por manzana</span>
          <span class="layer-count">59,582</span>
          <div class="toggle-sw on" id="sw-iep"></div>
        </div>

        <div class="layer-item" id="li-inun" onclick="toggleLayer('inun')">
          <div class="layer-dot" style="background:#2979ff"></div>
          <span class="layer-name">Zona inundación</span>
          <span class="layer-count">47,407</span>
          <div class="toggle-sw" id="sw-inun"></div>
        </div>

        <div class="layer-item" id="li-enc" onclick="toggleLayer('enc')">
          <div class="layer-dot" style="background:#00bcd4"></div>
          <span class="layer-name">Encharcamiento</span>
          <span class="layer-count">15,979</span>
          <div class="toggle-sw" id="sw-enc"></div>
        </div>

        <div class="layer-item" id="li-geo" onclick="toggleLayer('geo')">
          <div class="layer-dot" style="background:#ff6d00"></div>
          <span class="layer-name">Suscept. geológica</span>
          <span class="layer-count">161,734</span>
          <div class="toggle-sw" id="sw-geo"></div>
        </div>

        <div class="sec-label" style="margin-top:18px;">Ellipsis Drive</div>
        <div style="background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:12px;font-size:12px;color:var(--text-muted);">
          <div style="color:var(--green);font-weight:700;margin-bottom:4px;">● Conectado</div>
          <div>pathId: 6f6c63ec-4765-...</div>
          <div style="margin-top:6px;font-size:11px;">Sube los GeoTIFF procesados a tu Drive para activar las capas ráster (IEP continuo, NDVI, pendiente).</div>
          <div style="margin-top:8px;">
            <a href="https://app.ellipsis-drive.com/drive/external?pathId=6f6c63ec-4765-498f-b8a3-2fc35b889b30"
               target="_blank"
               style="color:var(--blue2);font-weight:700;text-decoration:none;font-size:11px;">
              → Abrir Ellipsis Drive ↗
            </a>
          </div>
        </div>
      </div>

      <!-- ── FILTROS ── -->
      <div class="s-panel" id="tab-filtros">

        <div class="sec-label">Nivel de riesgo IEP</div>
        <div class="filter-group">
          <div class="filter-label">Clases visibles <span id="iep-filter-label">todas</span></div>
          <div class="iep-btns">
            <span class="iep-btn active" style="background:rgba(26,150,65,.15);color:var(--iep1)" onclick="toggleIEP(1,this)">Muy bajo</span>
            <span class="iep-btn active" style="background:rgba(166,217,106,.15);color:#7ab648" onclick="toggleIEP(2,this)">Bajo</span>
            <span class="iep-btn active" style="background:rgba(255,193,7,.15);color:var(--yellow)" onclick="toggleIEP(3,this)">Moderado</span>
            <span class="iep-btn active" style="background:rgba(244,109,67,.15);color:var(--iep4)" onclick="toggleIEP(4,this)">Alto</span>
            <span class="iep-btn active" style="background:rgba(215,48,39,.15);color:var(--iep5)" onclick="toggleIEP(5,this)">Muy alto</span>
          </div>
        </div>

        <div class="sec-label">IEP mínimo</div>
        <div class="filter-group">
          <div class="filter-label">Umbral mínimo <span id="iep-min-label">0.0</span></div>
          <div class="slider-wrap">
            <input type="range" id="iep-slider" min="0" max="1" step="0.05" value="0"
                   oninput="filterByIEP(this.value)">
          </div>
        </div>

        <div class="sec-label" style="margin-top:16px;">Período de retorno (inundación)</div>
        <div class="filter-group">
          <div class="filter-label">Filtrar por Tr</div>
          <div class="iep-btns">
            <span class="iep-btn active" style="background:rgba(41,121,255,.12);color:var(--blue2)" onclick="toggleTR('10 años',this)">Tr10</span>
            <span class="iep-btn active" style="background:rgba(41,121,255,.12);color:var(--blue2)" onclick="toggleTR('25 años',this)">Tr25</span>
            <span class="iep-btn active" style="background:rgba(41,121,255,.12);color:var(--blue2)" onclick="toggleTR('100 años',this)">Tr100</span>
            <span class="iep-btn active" style="background:rgba(41,121,255,.12);color:var(--blue2)" onclick="toggleTR('500 años',this)">Tr500</span>
            <span class="iep-btn active" style="background:rgba(41,121,255,.12);color:var(--blue2)" onclick="toggleTR('1000 años',this)">Tr1000</span>
          </div>
        </div>

        <div class="sec-label" style="margin-top:16px;">Municipio</div>
        <div id="mun-btns" style="line-height:2;">
          <span class="mun-btn active" onclick="filterMun('todos',this)">Todos</span>
          <span class="mun-btn" onclick="filterMun('Apodaca',this)">Apodaca</span>
          <span class="mun-btn" onclick="filterMun('García',this)">García</span>
          <span class="mun-btn" onclick="filterMun('San Pedro GG',this)">San Pedro</span>
          <span class="mun-btn" onclick="filterMun('Escobedo',this)">Escobedo</span>
          <span class="mun-btn" onclick="filterMun('Guadalupe',this)">Guadalupe</span>
          <span class="mun-btn" onclick="filterMun('Juárez',this)">Juárez</span>
          <span class="mun-btn" onclick="filterMun('Monterrey',this)">Monterrey</span>
          <span class="mun-btn" onclick="filterMun('Santiago',this)">Santiago</span>
          <span class="mun-btn" onclick="filterMun('Sta Catarina',this)">Sta Catarina</span>
          <span class="mun-btn" onclick="filterMun('San Nicolás',this)">San Nicolás</span>
        </div>

        <div style="margin-top:16px;">
          <button class="map-btn" style="width:100%;padding:12px;" onclick="resetFilters()">↺ Resetear filtros</button>
        </div>
      </div>

      <!-- ── STATS ── -->
      <div class="s-panel" id="tab-stats">
        <div class="sec-label">IEP v2.0 — 5 variables</div>

        <div class="stats-grid">
