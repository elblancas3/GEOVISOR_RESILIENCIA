let map, layers = {}, baseLayers = {};
let iepLayer = null, inunLayer = null, encLayer = null, geoLayer = null;
let iepData = null;
let activeIEP = new Set([1,2,3,4,5]);
let activeTR  = new Set(['10 años','25 años','100 años','500 años','1000 años']);
let activeMun = 'todos';
let iepMin    = 0;
let layerOpacity = 0.85;

// ════════════════════════════════════════════════════════════════
// INIT MAP
// ════════════════════════════════════════════════════════════════
function initMap() {
  map = L.map('map', {
    center: ZMM_CENTER, zoom: ZMM_ZOOM,
    zoomControl: false
  });

  // Zoom control arriba-derecha
  L.control.zoom({ position: 'bottomright' }).addTo(map);
  L.control.scale({ imperial: false, position: 'bottomright' }).addTo(map);

  // BASE LAYERS
  baseLayers.carto = L.tileLayer(
    'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
    { attribution:'&copy; CartoDB', maxZoom:19 }
  ).addTo(map);

  baseLayers.osm = L.tileLayer(
    'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
    { attribution:'&copy; OSM', maxZoom:19 }
  );

  baseLayers.esri = L.tileLayer(
    'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
    { attribution:'&copy; Esri', maxZoom:19 }
  );
}

// ════════════════════════════════════════════════════════════════
// CARGAR IEP
// ════════════════════════════════════════════════════════════════
async function loadIEP() {
  setLoadMsg('Conectando a Ellipsis Drive — IEP manzanas...');
  try {
    // 1) Obtener timestamps del path
    setLoadMsg('Conectando Ellipsis Drive...');
    const tsResp = await fetch(`${ED_API}/path/${IEP_PATH_ID}/vector/timestamp`);
    if (!tsResp.ok) throw new Error(`Ellipsis timestamps: ${tsResp.status}`);
    const tsRaw  = await tsResp.json();
    // Ellipsis puede devolver array directo o { result: [...] }
    const timestamps = Array.isArray(tsRaw) ? tsRaw : (tsRaw.result || []);
    if (!timestamps.length) throw new Error('Sin timestamps en Ellipsis Drive');
    const timestampId = timestamps[0].id;
    console.log('Timestamp ID:', timestampId);

    // 2) Obtener archivos del timestamp
    setLoadMsg('Obteniendo archivos...');
    const filesResp = await fetch(`${ED_API}/path/${IEP_PATH_ID}/vector/timestamp/${timestampId}/file`);
    if (!filesResp.ok) throw new Error(`Ellipsis files: ${filesResp.status}`);
    const filesRaw = await filesResp.json();
    const files = Array.isArray(filesRaw) ? filesRaw : (filesRaw.result || []);
    if (!files.length) throw new Error('Sin archivos en el timestamp');
    const fileId = files[0].id;
    console.log('File ID:', fileId);

    // 3) Descargar GeoJSON
    const url = `${ED_API}/path/${IEP_PATH_ID}/vector/timestamp/${timestampId}/file/${fileId}/data`;
    setLoadMsg('Descargando manzanas IEP (~30MB)...');
    const resp = await fetch(url);
    if (!resp.ok) throw new Error(`Descarga GeoJSON: ${resp.status}`);
    iepData = await resp.json();
    renderIEP();
    setLoadMsg('Cargando capas de inundación...');
  } catch(e) {
    console.warn('IEP desde Ellipsis falló:', e.message);
    showToast('⚠️ IEP no cargado — verifica que la capa sea pública en Ellipsis Drive');
  }
}

// Paleta IEP garantizada (fallback si el GeoJSON no trae iep_color)
const IEP_COLORS = {
  1: '#1a9641',  // Muy bajo  — verde
  2: '#a6d96a',  // Bajo      — verde claro
  3: '#ffc107',  // Moderado  — amarillo
  4: '#f46d43',  // Alto      — naranja
  5: '#d73027'   // Muy alto  — rojo
};

function getIEPColor(p) {
  return IEP_COLORS[p.iep_clase] || p.iep_color || '#aaa';
}

function renderIEP(filter = false) {
  if (!iepData) return;
  if (iepLayer) map.removeLayer(iepLayer);

  iepLayer = L.geoJSON(iepData, {
    style: feature => {
      const p = feature.properties;
      const visible = activeIEP.has(Number(p.iep_clase))
        && (p.iep_mean || 0) >= iepMin
        && (activeMun === 'todos' || p.mun === activeMun);
      if (!visible) {
        return { fillOpacity: 0, opacity: 0, weight: 0 };
      }
      return {
        fillColor:   getIEPColor(p),
        fillOpacity: layerOpacity,
        color:       '#ffffff',
        weight:      0.15,
        opacity:     0.5
      };
    },
    onEachFeature: (feature, layer) => {
      layer.on('click', () => showFeatureInfo(feature.properties));
      layer.on('mouseover', function() {
        const p = feature.properties;
        const visible = activeIEP.has(Number(p.iep_clase))
          && (p.iep_mean||0) >= iepMin
          && (activeMun==='todos' || p.mun===activeMun);
        if (visible) {
          this.setStyle({ weight:1.5, color:'#fff', fillOpacity:1 });
          this.bringToFront();
        }
      });
      layer.on('mouseout', function() { iepLayer.resetStyle(this); });
    }
  });

  if (document.getElementById('sw-iep').classList.contains('on')) {
    iepLayer.addTo(map);
  }
}

// ════════════════════════════════════════════════════════════════
// CARGAR INUNDACIÓN
// ════════════════════════════════════════════════════════════════
async function loadInundacion() {
  try {
    const resp = await fetch(URLS.inun);
    const data = await resp.json();

    const COLORS_TR = {
      '10 años':'#0d47a1','25 años':'#1565c0','100 años':'#1976d2',
      '500 años':'#42a5f5','1000 años':'#90caf9'
    };

    inunLayer = L.geoJSON(data, {
      style: feat => {
        const tr = feat.properties.Per_Retorn;
        const visible = activeTR.has(tr);
        return {
          fillColor: COLORS_TR[tr] || '#1976d2',
          color: '#0d47a1', weight: 0.5,
          fillOpacity: visible ? 0.35 : 0,
          opacity: visible ? 0.6 : 0
        };
      },
      onEachFeature: (feat, layer) => {
        layer.bindPopup(`<b>Zona de Inundación</b><br>Período: <b>${feat.properties.Per_Retorn}</b>`, { className:'dark-popup' });
      }
    });
  } catch(e) { console.warn('Inundación no cargada:', e.message); }
}

// ════════════════════════════════════════════════════════════════
// CARGAR ENCHARCAMIENTO
// ════════════════════════════════════════════════════════════════
async function loadEncharcamiento() {
  try {
    const resp = await fetch(URLS.enc);
    const data = await resp.json();

    encLayer = L.geoJSON(data, {
      style: { fillColor:'#00bcd4', color:'#006064', weight:0.5, fillOpacity:0.4 },
      onEachFeature: (feat, layer) => {
        layer.bindPopup(`<b>Encharcamiento</b><br>Peligro: <b>${feat.properties.Peligro}</b>`);
      }
    });
  } catch(e) { console.warn('Encharcamiento no cargado:', e.message); }
}

// ════════════════════════════════════════════════════════════════
// CARGAR SUSCEPTIBILIDAD GEOLÓGICA (datos embebidos)
// ════════════════════════════════════════════════════════════════
function loadGeo() {
  const GEO_COLORS = {'Muy Alta':'#d73027','Alta':'#f46d43','Media':'#fdae61'};
  geoLayer = L.geoJSON(GEO_DATA, {
    style: feat => ({
      fillColor: GEO_COLORS[feat.properties.Susceptibi] || '#fdae61',
      color: '#7a3a00', weight: 0.4,
      fillOpacity: 0.55
    }),
    onEachFeature: (feat, layer) => {
      layer.bindPopup(
        `<b>Susceptibilidad Geológica</b><br>` +
        `Clase: <b style="color:${GEO_COLORS[feat.properties.Susceptibi]}">${feat.properties.Susceptibi}</b>`
      );
    }
  });
}

// ════════════════════════════════════════════════════════════════
// TOGGLE CAPAS
// ════════════════════════════════════════════════════════════════
function toggleLayer(name) {
  const sw = document.getElementById('sw-'+name);
  const li = document.getElementById('li-'+name);
  const isOn = sw.classList.contains('on');

  if (isOn) {
    sw.classList.remove('on'); li.classList.remove('active');
    if (name==='iep' && iepLayer) map.removeLayer(iepLayer);
    if (name==='inun' && inunLayer) map.removeLayer(inunLayer);
    if (name==='enc' && encLayer)  map.removeLayer(encLayer);
    if (name==='geo' && geoLayer)  map.removeLayer(geoLayer);
  } else {
    sw.classList.add('on'); li.classList.add('active');
    if (name==='iep')  { if(iepLayer) iepLayer.addTo(map); else { loadIEP().then(()=>{ if(iepLayer) iepLayer.addTo(map); }); }}
    if (name==='inun') { if(inunLayer) inunLayer.addTo(map); else { loadInundacion().then(()=>{ if(inunLayer) inunLayer.addTo(map); }); }}
    if (name==='enc')  { if(encLayer) encLayer.addTo(map); else { loadEncharcamiento().then(()=>{ if(encLayer) encLayer.addTo(map); }); }}
    if (name==='geo')  { if(geoLayer) geoLayer.addTo(map); else { loadGeo(); geoLayer.addTo(map); }}
  }
}

function toggleBase(name) {
  Object.keys(baseLayers).forEach(k => {
    map.removeLayer(baseLayers[k]);
    document.getElementById('sw-'+k)?.classList.remove('on');
    document.getElementById('sw-'+k)?.closest('.layer-item')?.classList.remove('active');
  });
  baseLayers[name].addTo(map);
  const sw = document.getElementById('sw-'+name);
  sw?.classList.add('on');
  sw?.closest('.layer-item')?.classList.add('active');
}

// ════════════════════════════════════════════════════════════════
// FILTROS
// ════════════════════════════════════════════════════════════════
function toggleIEP(clase, btn) {
  btn.classList.toggle('active');
  if (activeIEP.has(clase)) activeIEP.delete(clase);
  else activeIEP.add(clase);
  document.getElementById('iep-filter-label').textContent =
    activeIEP.size === 5 ? 'todas' : `${activeIEP.size} activas`;
  renderIEP();
}

function filterByIEP(val) {
  iepMin = parseFloat(val);
  document.getElementById('iep-min-label').textContent = parseFloat(val).toFixed(2);
  renderIEP();
}

function toggleTR(tr, btn) {
  btn.classList.toggle('active');
  if (activeTR.has(tr)) activeTR.delete(tr); else activeTR.add(tr);
  if (inunLayer) {
    inunLayer.setStyle(feat => {
      const visible = activeTR.has(feat.properties.Per_Retorn);
      const COLORS_TR = {'10 años':'#0d47a1','25 años':'#1565c0','100 años':'#1976d2','500 años':'#42a5f5','1000 años':'#90caf9'};
      return { fillColor: COLORS_TR[feat.properties.Per_Retorn]||'#1976d2',
               color:'#0d47a1', weight:0.5,
               fillOpacity: visible ? 0.35 : 0, opacity: visible ? 0.6 : 0 };
    });
  }
}

function filterMun(mun, btn) {
  document.querySelectorAll('.mun-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  activeMun = mun;
  renderIEP();
  if (mun !== 'todos' && iepData) {
    // Zoom al municipio
    const features = iepData.features.filter(f => f.properties.mun === mun);
    if (features.length > 0) {
      const tempLayer = L.geoJSON({ type:'FeatureCollection', features });
      map.fitBounds(tempLayer.getBounds(), { padding:[40,40] });
    }
  } else {
    zoomToZMM();
  }
}

function resetFilters() {
  activeIEP = new Set([1,2,3,4,5]);
  activeTR  = new Set(['10 años','25 años','100 años','500 años','1000 años']);
  activeMun = 'todos'; iepMin = 0;
  document.getElementById('iep-slider').value = 0;
  document.getElementById('iep-min-label').textContent = '0.0';
  document.getElementById('iep-filter-label').textContent = 'todas';
  document.querySelectorAll('.iep-btn').forEach(b => b.classList.add('active'));
  document.querySelectorAll('.mun-btn').forEach(b => b.classList.remove('active'));
  document.querySelector('.mun-btn').classList.add('active');
  renderIEP();
  zoomToZMM();
  showToast('✓ Filtros reseteados');
}

// ════════════════════════════════════════════════════════════════
// INFO PANEL
// ════════════════════════════════════════════════════════════════
function showFeatureInfo(p) {
  const panel = document.getElementById('info-panel');
  const body  = document.getElementById('ip-body');
  panel.style.display = 'block';

  const iepColors = { 1:'#1a9641',2:'#a6d96a',3:'#ffc107',4:'#f46d43',5:'#d73027' };
  const color = iepColors[p.iep_clase] || '#888';

  body.innerHTML = `
    <div class="ip-row"><span class="ip-key">CVEGEO</span><span class="ip-val">${p.CVEGEO}</span></div>
    <div class="ip-row"><span class="ip-key">Municipio</span><span class="ip-val">${p.mun||'—'}</span></div>
    <div class="ip-row"><span class="ip-key">Población</span><span class="ip-val">${(p.POB1||0).toLocaleString()} hab</span></div>
    <div class="ip-row"><span class="ip-key">IEP medio</span><span class="ip-val" style="color:${color}">${(p.iep_mean||0).toFixed(3)}</span></div>
    <div class="ip-iep-bar" style="background:linear-gradient(90deg,${color} ${(p.iep_mean||0)*100}%,var(--border) 0%)"></div>
    <div class="ip-iep-label" style="color:${color}">● ${p.iep_label||'—'}</div>
  `;
}

function closeInfo() {
  document.getElementById('info-panel').style.display = 'none';
}

// ════════════════════════════════════════════════════════════════
// UTILIDADES
// ════════════════════════════════════════════════════════════════
function showTab(id) {
  document.querySelectorAll('.s-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.stab').forEach(t => t.classList.remove('active'));
  document.getElementById('tab-'+id).classList.add('active');
  event.target.classList.add('active');
}

function zoomToZMM() {
  map.flyTo(ZMM_CENTER, ZMM_ZOOM, { duration:1.2 });
}

function toggleOpacity() {
  layerOpacity = layerOpacity === 0.85 ? 0.5 : layerOpacity === 0.5 ? 1.0 : 0.85;
  showToast(`Opacidad: ${Math.round(layerOpacity*100)}%`);
  renderIEP();
}

function searchPlace(q) {
  if (q.length < 3) return;
  // Buscar dentro del GeoJSON por municipio
  if (!iepData) return;
  const munMap = {
    'apodaca': [25.78,-100.19], 'garcia': [25.81,-100.59],
    'san pedro': [25.65,-100.41], 'escobedo': [25.79,-100.32],
    'guadalupe': [25.68,-100.26], 'juarez': [25.64,-100.09],
    'monterrey': [25.67,-100.31], 'santiago': [25.43,-100.15],
    'catarina': [25.67,-100.46], 'nicolás': [25.74,-100.30]
  };
  const ql = q.toLowerCase();
  for (const [k,v] of Object.entries(munMap)) {
    if (k.includes(ql)) { map.flyTo(v, 13, {duration:1}); break; }
  }
}

function setLoadMsg(msg) {
  const el = document.getElementById('ld-msg');
  if (el) el.textContent = msg;
}

function showToast(msg, duration=2500) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), duration);
}

// ════════════════════════════════════════════════════════════════
// MAIN INIT
// ════════════════════════════════════════════════════════════════
async function main() {
  initMap();
  setLoadMsg('Cargando capas IEP...');
  await loadIEP();
  setLoadMsg('Cargando inundación...');
  await loadInundacion();
  setLoadMsg('Cargando encharcamiento...');
  await loadEncharcamiento();

  // Ocultar loading
  setTimeout(() => {
    const ld = document.getElementById('loading');
    ld.classList.add('fade');
    setTimeout(() => ld.style.display='none', 500);
    showToast('✓ Geovisor ZMM listo · Click en manzana para ver IEP');
  }, 500);
}

main();
</script>

